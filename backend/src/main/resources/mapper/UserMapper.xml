<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campushub.mapper.UserMapper">

    <select id="getUserByStudentNo" resultType="com.campushub.entity.User">
        select * from `user` where student_no = #{studentNo}
    </select>

    <select id="getUserById" resultType="com.campushub.entity.User">
        select * from `user` where id = #{id}
    </select>

    <insert id="insertUser" parameterType="com.campushub.entity.User" useGeneratedKeys="true" keyProperty="id">
        insert into `user` (student_no, password, nickname, phone, avatar, role, status)
        values (#{studentNo}, #{password}, #{nickname}, #{phone}, #{avatar}, #{role}, #{status})
    </insert>

    <update id="updatePassword">
        update `user` set password = #{password} where id = #{id}
    </update>

    <select id="listForAdmin" resultType="com.campushub.entity.User">
        select * from `user`
        <where>
            <if test="keyword != null and keyword != ''">
                and (student_no like concat('%', #{keyword}, '%')
                     or nickname like concat('%', #{keyword}, '%'))
            </if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by id
        limit #{offset}, #{pageSize}
    </select>

    <select id="countForAdmin" resultType="int">
        select count(*) from `user`
        <where>
            <if test="keyword != null and keyword != ''">
                and (student_no like concat('%', #{keyword}, '%')
                     or nickname like concat('%', #{keyword}, '%'))
            </if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
    </select>

    <update id="updateStatus">
        update `user` set status = #{status} where id = #{id}
    </update>

</mapper>
