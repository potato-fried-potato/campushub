# docker compose 环境变量示例（复制为 .env 后按需修改）
MYSQL_ROOT_PASSWORD=123456
APP_PORT=8080
MYSQL_PORT=3307
# 后端直连调试端口（前端容器不经过它，走服务名 backend:8080）
BACKEND_PORT=8081
JAVA_OPTS=-XX:MaxRAMPercentage=75
# Maven 依赖镜像（国内网络建议保留；留空则使用官方 Maven Central）
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
# 镜像名：本地构建保持默认；部署时改成已发布镜像
BACKEND_IMAGE=campushub-backend:local
FRONTEND_IMAGE=campushub-frontend:local
